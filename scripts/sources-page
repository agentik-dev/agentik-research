#!/usr/bin/python3
# sources-page <repo root> [<date>]: write docs/sources.md from research/sources/ front matter, and
# docs/assets/data/sources.json, the same sources as rows for the faceted browse (glass-browse.js; docs/assets/javascripts/agentik.js).
# One line per web address (notes on one address merge into its line) and one per repository, `path:` and commit
# (a file read at two commits is on two lines). <date> stamps the browse's data-generated attribute; it defaults to today.
# The intro is written here, below; its counts come from the notes. On stderr: the footnotes on the pages that no note
# covers (page, footnote key, address), and notes on one address that disagree on the level or the year.
import glob, json, os, re, sys, collections
os.chdir(sys.argv[1])
# The levels, strongest first. A level's heading names the kinds of source under it (see KIND_NAMES), from the rows.
LABELS = collections.OrderedDict([("measured", "Measured"), ("documented", "Documented"), ("reported", "Reported"), ("our-use", "Our use")])
groups = collections.OrderedDict((k, []) for k in LABELS)
GENERATED = sys.argv[2] if len(sys.argv) > 2 else __import__('datetime').date.today().isoformat()
entries = collections.OrderedDict()  # key -> {"d": the first note's front matter, "key", "first", "bodies" and "texts" of every note, "level", "row"}
def fm(text):
    m = re.match(r"---\n(.*?)\n---\n(.*)", text, re.S)
    if not m: return None, text
    d = {}
    for line in m.group(1).splitlines():
        mm = re.match(r"^(\w+):\s*(.*)$", line)
        if mm:
            v = mm.group(1), mm.group(2).strip()
            k, val = v
            if val.startswith('"') and val.count('"') >= 2:
                val = val[1:val.rindex('"')]
            elif val.startswith("'") and val.count("'") >= 2:
                val = val[1:val.rindex("'")]
            else:
                val = re.sub(r"\s+#.*$", "", val).strip()
            d[k] = val.replace('\\"', '"')
    return d, m.group(2)
def shorten(s, n=220):
    # Cut at the last clause end before n characters; else at a word, never between a number and its unit.
    if len(s) <= n: return s
    cut = max(s.rfind("; ", 0, n), s.rfind(". ", 0, n))
    if cut >= 100: return s[:cut]
    words = s[:n].rsplit(" ", 1)[0].split(" ")
    while words and re.fullmatch(r"[\d.,%$()-]+", words[-1]): words.pop()
    return " ".join(words).rstrip(",;:") + " …"
def display_author(d, key):
    author = clean(d.get("author", "")) or "Unsigned"
    al = author.lower()
    if "github.com" in key and ("issue" in key or "/pull/" in key) and (" " not in author or "reporter" in al or "handle" in al or "author" in al):
        return "Pull request author" if "/pull/" in key else "Issue reporter"
    if any(w in al for w in ("unsigned", "not named", "unknown", "handle", "not recorded", "no author", "unnamed", "named in the url")):
        base = author.split(" (")[0].strip()
        bl = base.lower()
        if base and base != author and not bl.startswith("the ") and not any(w in bl for w in ("unsigned", "not named", "unknown", "no author", "unnamed", "reporter")):
            return base
        return "Unsigned"
    return author
def clean(s):
    s = re.sub(r"\s+", " ", s).strip().rstrip(".")
    s = s.replace('\\"', '"')
    return s
def year_of(pub):
    # The year the source states. A value with "undated", or one that is only an access phrase ("read October 2026"),
    # gives no publication date, so its year is "undated" even when the phrase names one.
    if not pub or "undated" in pub.lower() or re.match(r"\s*(read|accessed|retrieved|opened)\b", pub, re.I): return "undated"
    y = re.search(r"\b(19|20)\d{2}\b", pub)
    return y.group(0) if y else "undated"
nnotes = 0
for p in sorted(glob.glob("research/sources/*.md")):
    if p.endswith("README.md"): continue
    raw = open(p, encoding="utf-8").read()
    d, body = fm(raw)
    if not d: continue
    nnotes += 1
    kind = d.get("kind", "").split("|")[0].strip().replace(" ", "-")
    if kind not in groups: kind = "our-use" if "repo" in d else "reported"
    # A web source is its address; a repository source is its repository, path and commit together.
    if "url" in d: key = d["url"].rstrip("/")
    else: key = d.get("repo", "") + ":" + d.get("path", "") + "@" + d.get("commit", "")
    note = (os.path.basename(p), kind, d.get("published", ""))
    if key in entries:
        entries[key]["bodies"].append(body); entries[key]["texts"].append(raw.lower()); entries[key]["notes"].append(note)
        continue
    first = ""
    m = re.search(r"^## What it says\s*\n(.*?)(?=^## |\Z)", body, re.M | re.S)
    if m:
        for b in re.findall(r"^\s*[-*]\s+(.+)$", m.group(1), re.M):
            if re.match(r"(Read by |Opened:|Skimmed:|Read in full\.?$)", b): continue
            b = re.sub(r"^(Read in full\.\s+|[\w./-]+:\d[\d-]*\.\s+)", "", b)
            first = clean(b); break
    first = shorten(first)
    entries[key] = {"d": d, "key": key, "first": first, "bodies": [body], "texts": [raw.lower()], "notes": [note]}

# Notes on one address can disagree. The level is settled in the notes, from what each source shows (docs/method.md,
# "The evidence levels": a vendor post that states no sample is reported, not documented). Any disagreement left takes
# the weaker level, in the order of LABELS (measured, documented, reported, our use), since a line claims no more than
# its weakest reading; the generator warns, so the notes get settled. A date: when one note found the page undated and
# another gives a year, the line is undated and shows the first undated note's wording (the changelog page: three notes
# say "undated page", one "entries dated individually", and a page whose entries carry the dates states none of its
# own). Two notes that give different years keep the first. Either way the generator warns.
ORDER = list(LABELS)
for e in entries.values():
    kinds = [k for _, k, _ in e["notes"]]
    e["level"] = max(kinds, key=ORDER.index)
    if len(set(kinds)) > 1:
        print(f"notes disagree on the level of {e['key']}:", ", ".join(f"{n} {k}" for n, k, _ in e["notes"]) + f"; the line is {e['level']}", file=sys.stderr)
    pubs = [pub for _, _, pub in e["notes"]]
    years = {year_of(pub) for pub in pubs}
    e["published"] = next((pub for pub in pubs if year_of(pub) == "undated"), pubs[0]) if "undated" in years else pubs[0]
    if len(years) > 1:
        print(f"notes disagree on the year of {e['key']}:", ", ".join(f"{n} {year_of(pub)}" for n, _, pub in e["notes"]) + f"; the line is {year_of(e['published'])}", file=sys.stderr)
    groups[e["level"]].append(e)

# --- Facets ----------------------------------------------------------------
LEVEL_NAME = {"measured": "measured", "documented": "documented", "reported": "reported", "our-use": "our use"}
QUESTIONS = {1: "1 Length", 2: "2 Compaction or restart", 3: "3 Memory", 4: "4 Budgets and pacing", 5: "5 Many agents",
             6: "6 Unattended runs", 7: "7 Guardrails", 8: "8 Review", 9: "9 Telling people", 10: "10 Cost lanes"}
CHAPTERS = {"length-and-compaction": [1, 2], "memory": [3], "budgets-and-lanes": [4, 10], "many-agents": [5],
            "unattended-and-guardrails": [6, 7], "review": [8], "telling-people": [9]}
TOOLS = ("session", "relay", "decisions", "respeak", "agents", "commons")
def source_kind(d, level):
    if "url" not in d: return "Repository"
    u = d["url"].lower()
    if re.search(r"github\.com/[^/]+/[^/]+/(issues|pull)/", u): return "Issue or pull request"
    if re.search(r"arxiv\.org|doi\.org|ncbi\.nlm|pubmed|europepmc|ebi\.ac\.uk|acm\.org|aclanthology|openreview|nature\.com|sciencedirect|springer|wiley|cambridge\.org|jstor|ssrn|repec|ro\.ecu|dash\.harvard|\.edu/.*\.pdf|interruptions\.net|nottingham\.ac\.uk/.*\.pdf|govinfo\.gov", u): return "Paper or report"
    if re.search(r"code\.claude\.com/docs|docs\.anthropic|platform\.claude\.com/docs|support\.claude|readthedocs|/docs/|docs\.", u): return "Documentation"
    if re.search(r"anthropic\.com/(engineering|news|research)|claude\.com/blog|claude\.dev/blog|platform\.claude\.com/cookbook", u): return "Vendor writing"
    # The note's level says whose text it is: a documented-level note that no address rule above places is the
    # publisher's own file or page (a raw CHANGELOG, a pricing page, a style guide), so it is documentation.
    # A GitHub repository page stays code, below.
    if level == "documented" and "github.com/" not in u: return "Documentation"
    if "github.com" in u: return "Code or repository"
    return "Article or post"
def questions(bodies):
    qs = []
    for body in bodies:
        m = re.search(r"^## Used in\s*\n(.*?)(?=^## |\Z)", body, re.M | re.S)
        for line in (m.group(1) if m else "").splitlines():
            for n in re.findall(r"field-(\d+)", line):
                qs.append(QUESTIONS.get(int(n)))
            for ch in re.findall(r"docs/field/([\w-]+)\.md", line):
                qs += [QUESTIONS[n] for n in CHAPTERS.get(ch, [])]
            for t in re.findall(r"(?:tools-|docs/tools/)(\w+)", line):
                qs.append("The tools" if t == "index" else f"agentik-{t}" if t in TOOLS else None)
            if re.search(r"journal", line): qs.append("The journal")
    return sorted({q for q in qs if q}, key=lambda q: (not q[0].isdigit(), int(q.split()[0]) if q[0].isdigit() else 0, q))

# --- The pages that cite each source: footnote definitions in docs/ ---------
def norm(u):
    # Compare URLs without scheme, www, trailing slash or fragment, and in lower case; an arXiv paper by its id.
    u = re.sub(r"https?://(www\.)?", "", u.lower())
    u = re.sub(r"arxiv\.org/(abs|pdf|html)/(\d{4}\.\d{4,5})(v\d+)?(\.pdf)?", r"arxiv:\2", u)
    return re.sub(r"/(?=[\s>)#]|$)", "", u)
GH = re.compile(r"github\.com/([\w.-]+/[\w.-]+)/(blob|tree|commits|commit|compare)/([^\s>)#?\]]+)")
SHA = re.compile(r"\b(?=[0-9a-f]*\d)[0-9a-f]{7,40}\b")
RANGE = re.compile(r"\b([0-9a-f]{7,40})\.\.\.?([0-9a-f]{7,40})\b|\bfrom ([0-9a-f]{7,40}) to ([0-9a-f]{7,40})\b")
BARE = re.compile(r"[A-Z][a-z]*file|LICENSE|NOTICE|COPYING|CODEOWNERS")
def paths_in(s):
    # The paths a note's `path:` field, or a footnote's quoted string, names, in their real case. The field may be prose
    # ("the git history of each repository", "bin/ (the dispatcher ...)"), so a token counts as a path only when it
    # looks like one: it holds a "/", ends in a file extension, starts with a dot, or is a bare file name such as
    # Makefile. Plain words, commit ranges ("fabb212..569a120") and line suffixes ("README.md:309" is README.md) are
    # not paths. A folder keeps its trailing "/".
    out = []
    for t in re.split(r"[\s,;()]+", s):
        t = re.sub(r":\d[\d-]*$", "", t).rstrip(".:")
        if not t or ".." in t or not re.fullmatch(r"\.?[\w@+-][\w.@+-]*(/[\w.@+-]+)*/?", t): continue
        if "/" in t or t.startswith(".") or BARE.fullmatch(t) or re.search(r"\w\w\.[A-Za-z][A-Za-z0-9]{0,4}$", t):
            out.append(t)
    return out
def reads_history(path):
    # A note reads a git history when the prose of its `path:` says so: "the git history", "the commit log", "the commits".
    return bool({w.lower() for w in re.split(r"[\s,;()]+", path) if w and not paths_in(w)} & {"history", "log", "commits"})
for e in entries.values():
    d = e["d"]
    if "url" in d: continue
    # A note's `commit:` may list several commits (a note on the whole organization, one per repository); a history
    # read over a range ("the commits fabb212..569a120", "from 89c69a8 to e8477a7") covers the range's end too.
    e["commits"] = SHA.findall(d.get("commit", "").lower()) + [b or y for _, b, _, y in RANGE.findall(d.get("path", "").lower())]
    # Each path with the commits it was read at: the note's, or the one the field gives for it ("mkdocs.yml at 49fcc10").
    at = {re.sub(r":\d[\d-]*$", "", t).rstrip(".:"): c for t, c in re.findall(r"(\S+) at ([0-9a-f]{7,40})\b", d.get("path", ""))}
    e["read"] = [(n, [at[n]] if n in at else e["commits"]) for n in paths_in(d.get("path", ""))]
    e["history"] = reads_history(d.get("path", ""))
def footnote(key, raw):
    # One footnote definition: its key, its line as written ("raw"), lowercased for address matching ("line"), and what
    # it cites in a repository, as items. A history link (commits/<sha>) is ("history", repo, sha); a commit link,
    # ("commit", repo, sha); a compare link, ("compare", repo, "a...b"). A file or folder is ("path", repo, sha, path):
    # a file link's path; each quoted path ("design/review-r6.md"; a leading repository name, as in
    # ".github/profile/README.md", is dropped) at the commit of the footnote's file or folder links; and a folder
    # link's path when nothing is quoted. A footnote with no such link pairs each repository it names with the commits
    # that follow the name ("agentik-relay (405d1e0), agentik-session (e8477a7)"). A path "" is a whole repository.
    line = norm(raw)
    links = [(r.lower(), how, rest) for r, how, rest in GH.findall(raw)]
    items = [("history" if how == "commits" else how, r, rest.lower()) for r, how, rest in links if how in ("commits", "commit", "compare")]
    files = [(r, how, rest.partition("/")[0].lower(), rest.partition("/")[2].rstrip("/")) for r, how, rest in links if how in ("blob", "tree")]
    quoted = [q.rstrip("/") for q in re.findall(r'"([^"\s]+)"', raw) if paths_in(q)]
    at = {(r, c) for r, _, c, _ in files}
    if not at:
        repo = next((r for r, _, _ in links), None)
        for m in re.finditer(r"\b(agentik-(?!dev\b)[a-z]+)\b|" + SHA.pattern, line):
            if m.group(1): repo = "agentik-dev/" + m.group(1)
            elif repo: at.add((repo, m.group(0)))
    for r, c in sorted(at):
        for q in quoted:
            name = r.partition("/")[2]
            items.append(("path", r, c, q[len(name) + 1:] if q.startswith(name + "/") else q))
    items += [("path", r, c, p) for r, how, c, p in files if how == "blob" or not quoted]
    items = list(dict.fromkeys(items))
    return {"key": key, "raw": raw, "line": line, "items": items}
pages = {}
for path in sorted(glob.glob("docs/**/*.md", recursive=True)):
    text = open(path, encoding="utf-8").read()
    h1 = re.search(r"^title:\s*(.+)$", text.split("\n---", 1)[0], re.M) if text.startswith("---") else None
    h1 = h1 or re.search(r"^# (.+)$", text, re.M)
    rel = os.path.relpath(path, "docs")
    if rel == "sources.md": continue
    defs = [re.match(r"^\[\^([^\]]+)\]:", l) for l in text.splitlines()]
    pages[rel] = (h1.group(1).strip() if h1 else rel, [footnote(m.group(1), m.string) for m in defs if m])
def covers(e, item):
    # A repository note covers an item in its repository (a note on a whole organization: in any of its repositories)
    # only when it names the item's commit and, for a file or folder, the path itself or a folder holding it, as its
    # `path:` gives them. A history item needs a note that reads the history at that commit; a commit item, a note that
    # names the sha; a compare item, a note that names both ends.
    mine = e["d"].get("repo", "").lower().strip("/")
    org = "/" not in mine
    if not (item[1] == mine or (org and item[1].startswith(mine + "/"))): return False
    same = lambda a, cs: any(a.startswith(c) or c.startswith(a) for c in cs)
    if item[0] == "history": return e["history"] and same(item[2], e["commits"])
    if item[0] == "commit": return any(item[2] in t for t in e["texts"])
    if item[0] == "compare":
        a, _, b = item[2].partition("...")
        return bool(a and b and any(a in t and b in t for t in e["texts"]))
    _, _, sha, path = item
    return bool(path) and any(same(sha, cs) and (path == n.rstrip("/") or path.startswith(n.rstrip("/") + "/")) for n, cs in e["read"])
def cites_url(e, f):
    u = norm(e["d"]["url"]).split("#")[0]
    return re.search(re.escape(u) + r"(?=[\s>)#?\]]|$)", f["line"]) is not None
def cites(e, f): return cites_url(e, f) if "url" in e["d"] else any(covers(e, i) for i in f["items"])
def cited_on(e):
    hits = [t for t, fns in pages.values() if any(cites(e, f) for f in fns)]
    return sorted(set(hits)) or ["Research notes only"]

rows = []
for k, items in groups.items():
    for e in items:
        d, key, first = e["d"], e["key"], e["first"]
        if "url" in d:
            url = d["url"]
        else:
            repo, path_, commit = d.get("repo", ""), d.get("path", ""), d.get("commit", "")
            single = re.fullmatch(r"[0-9a-f]{7,40}", commit or "")
            url = (f"https://github.com/{repo}/{'tree' if path_.endswith('/') else 'blob'}/{commit}/{path_}"
                   if single and re.fullmatch(r"[\w./-]+", path_ or "") else f"https://github.com/{repo}")
        title = clean(d.get("title", "")) or key
        author = re.sub(r"\s*\([^()]*(\([^()]*\)[^()]*)*\)\s*$", "", display_author(d, key)) or display_author(d, key)
        row = {"t": title, "a": author, "y": year_of(e["published"]), "l": LEVEL_NAME[k],
               "k": source_kind(d, e["level"]), "qs": questions(e["bodies"]), "p": cited_on(e), "u": url}
        row["q"] = " ".join([title, author, row["y"], row["l"], row["k"], " ".join(row["qs"]), " ".join(row["p"]), first]).lower()
        rows.append(row)
        e["row"] = row

# Footnotes on the pages that no note covers: the intro's "every source" holds only when there are none. A footnote that
# cites a repository is covered when every item it cites (above) is covered by some note; one that cites a web address,
# when a note records the address. A footnote that cites only this repository's notes folder needs no note.
unmatched = []  # (page, footnote key, the address it cites, whether it cites an agentik repository)
for rel, (_, fns) in pages.items():
    for f in fns:
        urls = re.findall(r"<([^>\s]+)>", f["raw"]) + re.findall(r"\]\(([^)\s]+)\)", f["raw"])
        if all(norm(u).startswith("github.com/agentik-dev/agentik-research/tree/main/research/sources") for u in urls): continue
        ours = [i for i in f["items"] if i[1].startswith("agentik-dev/")]
        if ours: ok = all(any(covers(e, i) for e in entries.values() if "url" not in e["d"]) for i in ours)
        else: ok = any(cites(e, f) for e in entries.values())
        if not ok: unmatched.append((rel, f["key"], urls[0] if urls else f["raw"][:80], bool(ours) or "github.com/agentik-dev" in f["line"]))
for rel, key, u, _ in sorted(set(unmatched)): print(f"no note for {rel} [^{key}]: {u}", file=sys.stderr)

# --- The page ------------------------------------------------------------------
# The intro is written here; its counts come from the rows above, so a regeneration keeps it true.
vendor = [e for e in entries.values() if e["row"]["k"] == "Documentation" and e["row"]["a"].startswith("Anthropic")]
vendor_undated = [e for e in vendor if e["row"]["y"] == "undated"]
read_on = " or ".join(sorted({e["d"].get("accessed", "") for e in vendor_undated})) or "the date each note gives"
dated = ["\"" + clean(e["d"].get("title", "")) + "\", " + re.split(r" \(|; ", clean(e["published"]))[0] for e in vendor if e["row"]["y"] != "undated"]
dated_notes = [n for e in vendor if e["row"]["y"] != "undated" for n in e["notes"]]
# Files and folders read at two or more commits, by repository and path across every note on one repository (a note
# on a whole organization names no path).
read_at = collections.defaultdict(set)
for e in entries.values():
    if "url" in e["d"] or "/" not in e["d"].get("repo", ""): continue
    for n, cs in e["read"]:
        read_at[(e["d"]["repo"].lower(), n)].update(cs)
two_files = sorted(f"{r}:{n}" for (r, n), c in read_at.items() if len(c) > 1 and not n.endswith("/"))
two_folders = sorted(f"{r}:{n}" for (r, n), c in read_at.items() if len(c) > 1 and n.endswith("/"))
def count(n, one, many): return f"{n} {one if n == 1 else many}"
missing_repo = sorted({u for u in unmatched if u[3]})
missing_web = sorted(set(unmatched) - set(missing_repo))
lead = ("Every source behind this site, one line each, grouped by evidence level: the sources its pages cite, and the further sources the research notes read. "
        if not unmatched else
        "Every source a research note records, one line each, grouped by evidence level: the sources the site's pages cite, and the further sources the notes read. "
        + (f"{count(len(missing_repo), 'footnote', 'footnotes')} on the other pages {'has' if len(missing_repo) == 1 else 'have'} no line here: each cites a repository's file, folder or history that no note read at the cited commit. " if missing_repo else "")
        + (f"{count(len(missing_web), 'footnote', 'footnotes')} on the other pages {'cites' if len(missing_web) == 1 else 'cite'} a web address that no note records. " if missing_web else ""))
intro = [lead + f"The {len(entries)} lines come from {nnotes} notes in the repository's `research/sources/` folder, which record what was opened and when.[^notes]",
         "A web source is one line per address, so a second note on the same address joins its line. "
         "A repository source is one line per repository, paths and commit, so a file read at two commits is on two lines"
         + (f": the notes read {count(len(two_files), 'file', 'files')}" + (f" and {count(len(two_folders), 'folder', 'folders')}" if two_folders else "")
            + " at two or more commits" if two_files or two_folders else "") + ". "
         "Each line gives the author or organization, the title, the date the source states, where it was read, and one line of what it says. "
         "The browse below filters the lines by level, kind, question, year and the page that cites each one. "
         "A source that states no publication date sits under the year \"undated\", even when its note records when it was read.",
         "Issue reporters and unsigned pages are not named in the text. "
         "An issue in a person's public repository still carries that repository's owner in its link, since the link is the citation. "
         f"Most vendor documentation is undated by its publisher: {len(vendor_undated)} of the {len(vendor)} documentation sources from Anthropic state no date, "
         f"and their notes record a read on {read_on}."
         + ((f" The other one is dated as its {'note gives' if len(dated_notes) == 1 else 'notes give'}: " if len(dated) == 1
             else f" The other {len(dated)} are dated as their notes give: ")
            + "; ".join(dated) + "." if dated else "")]
out = ["---", "hide: [toc]", "---", "", "# Sources", ""] + [x for p_ in intro for x in (p_, "")]
out += ['<div class="gb-browse" data-page="sources" data-src="../assets/data/sources.json" data-generated="' + GENERATED + '">The browse needs JavaScript; the full list follows below.</div>', "",
        '<div class="ak-static-list" markdown>', ""]
# Each level's heading names the kinds of source it holds, most first, so it stays true when a note's level changes;
# the line below it counts them with the browse's own kind names.
KIND_NAMES = {"Paper or report": "papers or reports", "Article or post": "articles or posts", "Vendor writing": "vendor writing",
              "Documentation": "documentation", "Code or repository": "code repositories", "Issue or pull request": "issues or pull requests",
              "Repository": "the agentik repositories"}
def and_list(xs): return xs[0] if len(xs) == 1 else ", ".join(xs[:-1]) + " and " + xs[-1]
for k, items in groups.items():
    kinds = collections.Counter(e["row"]["k"] for e in items).most_common()
    kinds.sort(key=lambda kv: (-kv[1], kv[0]))
    out.append(f"## {LABELS[k]}: " + and_list([KIND_NAMES.get(x, x.lower()) for x, _ in kinds]))
    out.append("")
    out.append(f"{count(len(items), 'line', 'lines')} by kind: " + ", ".join(f"{x.lower()} {n}" for x, n in kinds) + ".")
    out.append("")
    for e in sorted(items, key=lambda e: (display_author(e["d"], e["key"]).lower(), e["d"].get("title", "").lower())):
        d, key, first = e["d"], e["key"], e["first"]
        author = display_author(d, key)
        title = clean(d.get("title", ""))
        date = clean(e["published"]) or "undated"
        if "url" in d:
            where = f"<{d['url']}>"
        else:
            repo = d.get("repo", ""); path = d.get("path", ""); commit = d.get("commit", "")
            short = repo.split("/")[-1]
            where = f"{repo}, `{path}` at {commit}" if commit else f"{repo}, `{path}`"
            single = re.fullmatch(r"[0-9a-f]{7,40}", commit or "")
            if repo and single and path and re.fullmatch(r"[\w./-]+", path):
                kind_ = "tree" if path.endswith("/") else "blob"
                where = f"[{short} `{path}` @ {commit}](https://github.com/{repo}/{kind_}/{commit}/{path})"
            elif "/" in repo and single:
                where = f"{repo}, `{path}`, at [{commit}](https://github.com/{repo}/tree/{commit})"
            elif repo:
                where = f"[{repo}](https://github.com/{repo}), `{path}`" + (f" at {commit}" if commit else "")
        line = f"- {author}, \"{title}\", {date}. {where}."
        if first: line += f" {first}" + ("" if first.endswith("…") else ".")
        out.append(line)
    out.append("")
out.append("</div>")
out.append("")
out.append("## Sources")
out.append("")
out.append("[^notes]: agentik-dev/agentik-research, \"research/sources/\", the source notes, on the main branch once the pull request merges, <https://github.com/agentik-dev/agentik-research/tree/main/research/sources>.")
open("docs/sources.md", "w", encoding="utf-8").write("\n".join(out) + "\n")

os.makedirs("docs/assets/data", exist_ok=True)
with open("docs/assets/data/sources.json", "w", encoding="utf-8") as f:
    json.dump(rows, f, ensure_ascii=False, separators=(",", ":"))
    f.write("\n")
print(len(rows), "browse rows;", os.path.getsize("docs/assets/data/sources.json"), "bytes")
print(len(entries), "sources from", nnotes, "notes;", os.path.getsize("docs/sources.md"), "bytes;", len(set(unmatched)), "footnotes with no note")
